# 本地 .env 保存实际部署值与凭据，.env.example 提供同结构配置模板。
# 复制模板后填写所用服务与路径；真实凭据仅保存在 Git 忽略的 .env。

# 模型 API 与认证
# Responses 自定义上游填写 BASE_URL、MODEL 和 API_KEY，BASE_URL 包含 /v1。
# 该上游覆盖所有角色的实际模型路由；留空 BASE_URL 时使用 LiteLLM Responses 的提供商认证。
# READ_TIMEOUT_SECONDS 为等待上游响应的秒数。密钥仅由本地 Host 读取。
MODEL_NAME='provider/model-id'
A3_UPSTREAM_RESPONSES_BASE_URL=''
A3_UPSTREAM_RESPONSES_MODEL=''
A3_UPSTREAM_RESPONSES_API_KEY=''
A3_UPSTREAM_RESPONSES_READ_TIMEOUT_SECONDS='300'

# 模型角色与推理设置
# 主模型、辅助模型和摘要模型分别指定思考强度，供应商需支持对应参数。
A3_MODEL_REASONING_EFFORT='medium'
A3_MODEL_SERVICE_TIER='default'
A3_WORKER_MODEL_NAME='provider/model-id'
A3_WORKER_REASONING_EFFORT='medium'
A3_SUMMARY_MODEL_NAME='provider/model-id'
A3_SUMMARY_REASONING_EFFORT='low'

# 上下文与压缩预算
# 单位为 token，按二进制对齐；依次为主模型、辅助模型、摘要窗口、压缩触发值及压缩目标。
# 262144=256 Ki=0x40000，524288=512 Ki=0x80000，196608=192 Ki=0x30000，32768=32 Ki=0x8000。
# 窗口应按提供商实际支持能力填写；目标预算包含固定指令、工具、反馈、摘要与最近完整回合。
A3_MODEL_CONTEXT_TOKENS='262144'
A3_WORKER_CONTEXT_TOKENS='262144'
A3_SUMMARY_CONTEXT_TOKENS='524288'
A3_CONTEXT_TRIGGER_TOKENS='196608'
A3_CONTEXT_TARGET_TOKENS='32768'

# 网页检索 API
# Tavily 密钥仅供 Host 使用。ENABLED=1 开启，0 关闭。
# HTTP_PROXY 仅用于 Tavily；缓存大小单位为字节，TTL 单位为秒。
TAVILY_API_KEY=''
A3_WEB_ENABLED='0'
A3_TAVILY_HTTP_PROXY=''
A3_WEB_CACHE_MAX_BYTES='500000000'
A3_WEB_SEARCH_TTL_SECONDS='86400'
A3_WEB_FETCH_TTL_SECONDS='604800'

# 百炼 Token Plan 凭据
# 保存 Token Plan 密钥；启用时将同一密钥填入上方 UPSTREAM_RESPONSES_API_KEY。
A3_BAILIAN_TOKEN_PLAN_API_KEY=''

# 研究看板
# 随研究 Host 自动启动和关闭，只监听回环地址；端口被占用时跳过，不影响研究。
A3_DASHBOARD_PORT='8787'

# 本地参考项目
# PROJECT_ROOT 为独立 A3 仿真仓库。
A3_PROJECT_ROOT='/path/to/a3_dual_arm_sim'

# 远程执行连接
# BACKEND 支持 process 与 docker；MANAGED_JOBS=1 开启服务器排队调度。
# process 后端的数据、解释器和仿真路径应位于执行端数据盘。
A3_REMOTE_HOST='ssh-host-alias'
A3_REMOTE_RUN_ROOT='/path/to/a3-research-agent/remote-runtime'
A3_REMOTE_CONTROLLER='/path/to/a3-research-agent/src/a3_research_agent/execution/controller/__main__.py'
A3_REMOTE_BACKEND='docker'
A3_REMOTE_MANAGED_JOBS='0'
A3_REMOTE_DATA_ROOT='/data/project'
A3_REMOTE_PROCESS_PYTHON='/data/project/a3/.venv/bin/python'
A3_REMOTE_A3_ROOT='/data/project/a3'
A3_REMOTE_IMAGE='remote-experiment-image'

# 整机资源与磁盘保护
# 内存单位为 MiB，磁盘单位为字节，超时单位为秒。
# HOST_JOB 为调度估算；MAX_JOBS、JOB_TIMEOUT、RUN_STORAGE_BYTES 为 0 时不限该项。
A3_REMOTE_HOST_MEMORY_RESERVE_MB='32768'
A3_REMOTE_HOST_JOB_MEMORY_MB='8192'
A3_REMOTE_HOST_CPU_RESERVE='2'
A3_REMOTE_HOST_JOB_CPUS='2'
A3_REMOTE_DISK_RESERVE_BYTES='68719476736'
A3_REMOTE_MAX_JOBS='2'
A3_REMOTE_JOB_TIMEOUT='900'
A3_REMOTE_RUN_STORAGE_BYTES='0'

# GPU 调度
# SHARE_GPUS=1 允许同卡多作业，MAX_GPUS 限制本项目同时使用的物理卡数。
# 显存单位为 MiB；MEMORY_MB 为作业默认预留，CAPACITY_MB=0 自动计算每卡容量。
A3_REMOTE_SHARE_GPUS='0'
A3_REMOTE_MAX_GPUS='4'
A3_REMOTE_GPU_MEMORY_MB='512'
# 托管队列在请求未声明峰值时的单作业显存预算；显式 gpu_memory_mb 保持原值。
A3_REMOTE_MANAGED_GPU_MEMORY_MB='8192'
A3_REMOTE_GPU_HEADROOM_MB='2048'
A3_REMOTE_GPU_CAPACITY_MB='0'

# 模型、数据与临时文件
# 持久数据、离线模型、缓存与临时文件目录均应指向执行端数据盘。
A3_REMOTE_MODELS_ROOT='/path/to/project/models'
A3_REMOTE_DATASETS_ROOT='/path/to/project/datasets'
A3_REMOTE_MODEL_CACHE_ROOT='/path/to/project/model-cache'
A3_REMOTE_PRESERVE_MODELS_PATH='0'
A3_REMOTE_TMP_ROOT='/path/to/data-disk/temporary'

# Docker 后端资源
# 单作业 CPU、内存与进程数量限制仅适用于 Docker 后端。
A3_REMOTE_CPUS='16'
A3_REMOTE_MEMORY='64g'
A3_REMOTE_PIDS_LIMIT='1024'

# 本地知识检索（记忆与技能共用）：预先安装 llama.cpp 并下载文档指定的 embedding 模型。
# 默认从 PATH 查找 llama-server，模型保存在项目 model-cache/。
A3_EMBEDDING_SERVER='llama-server'
# 可选：同一已审核模型的本地文件路径，加载时仍校验固定 SHA256。
# A3_EMBEDDING_MODEL='/path/to/model.gguf'

# 夜间窗口
# 每晚 21:00 开始；END_HOUR 为次日结束小时（默认 9 即 09:00）。
A3_NIGHT_WINDOW_END_HOUR='9'
