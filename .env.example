# Copy to .env and fill in deployment values. Keep .env outside version control.
MODEL_NAME='provider/model'
MODEL_CLASS='model-adapter'
MODEL_COST_TRACKING='default'
# Optional Host-owned inference policy, applied to main, summary and worker calls.
# A3_MODEL_REASONING_EFFORT='medium'
# A3_MODEL_SERVICE_TIER='default'
# Optional fixed role models. Main and candidate behavioral trials keep MODEL_NAME.
# A3_WORKER_MODEL_NAME='provider/helper-model'
# A3_WORKER_REASONING_EFFORT='medium'
# A3_SUMMARY_MODEL_NAME='provider/summary-model'
# A3_SUMMARY_REASONING_EFFORT='low'
# Host token budgets default to 500k/400k/32k; 500k is a deployment cap.
# Summaries use the full window minus output space; no separate summary-input setting.
A3_MODEL_CONTEXT_TOKENS='500000'
A3_WORKER_CONTEXT_TOKENS='500000'
A3_SUMMARY_CONTEXT_TOKENS='500000'
A3_CONTEXT_TRIGGER_TOKENS='400000'
A3_CONTEXT_TARGET_TOKENS='32000'
A3_PROJECT_ROOT='/path/to/a3-experiment-worktree'
A3_REMOTE_HOST='ssh-host-alias'
A3_REMOTE_RUN_ROOT='/path/to/a3-research-agent/artifacts/remote-runtime'
A3_LOCAL_IMAGE='local-bootstrap-image'
A3_REMOTE_CONTROLLER='/path/to/a3-research-agent/src/a3_research_agent/execution/controller/__main__.py'
A3_REMOTE_IMAGE='remote-experiment-image'

# Optional Host-controlled execution settings. Zero timeout/storage means unlimited.
A3_REMOTE_MAX_JOBS='2'
A3_REMOTE_JOB_TIMEOUT='900'
A3_REMOTE_RUN_STORAGE_BYTES='0'
# Read-only project asset directories on the execution server.
# A3_REMOTE_MODELS_ROOT='/path/to/project/artifacts/models'
# A3_REMOTE_DATASETS_ROOT='/path/to/project/artifacts/datasets'

# Optional memory sharing; job count and physical GPU count are independent.
A3_REMOTE_SHARE_GPUS='0'
A3_REMOTE_MAX_GPUS='4'
A3_REMOTE_GPU_MEMORY_MB='512'
A3_REMOTE_GPU_HEADROOM_MB='2048'
A3_REMOTE_GPU_CAPACITY_MB='0'

# Optional offline asset cache and system-memory ceiling.
# A3_REMOTE_MODEL_CACHE_ROOT='/path/to/project/artifacts/model-cache'
A3_REMOTE_PRESERVE_MODELS_PATH='0'
A3_REMOTE_CPUS='16'
A3_REMOTE_MEMORY='64g'
A3_REMOTE_PIDS_LIMIT='1024'
# Put this directory on the execution server's data disk. Otherwise use server TMPDIR.
# A3_REMOTE_TMP_ROOT='/path/to/data-disk/temporary'

# Optional research web gateway. Configure ONLY on the local Host; never copy the key
# to candidate containers, execution servers, prompts, logs, or Git.
# No per-run search/fetch cap; legacy A3_WEB_SEARCH_LIMIT/FETCH_LIMIT are ignored.
# Provider quota/billing is user-controlled; the Host never purchases or upgrades.
TAVILY_API_KEY=''
A3_WEB_ENABLED='0'
# Optional: route ONLY Tavily API search/extract through an existing local HTTP proxy.
# Numeric loopback address only; no credentials. Does not change system/global proxy.
# A3_TAVILY_HTTP_PROXY='http://127.0.0.1:1082'
# Host-private, project-wide public research result cache; zero bytes disables.
A3_WEB_CACHE_MAX_BYTES='500000000'
A3_WEB_SEARCH_TTL_SECONDS='86400'
A3_WEB_FETCH_TTL_SECONDS='604800'
